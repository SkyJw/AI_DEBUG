# --- default profile (used by every agent unless overridden) ---
AIDBG_DEFAULT__BASE_URL=https://api.deepseek.com/v1
AIDBG_DEFAULT__API_KEY=sk-your-key-here
AIDBG_DEFAULT__MODEL=deepseek-chat

# --- an alternate local backend ---
AIDBG_OLLAMA__BASE_URL=http://localhost:11434/v1
AIDBG_OLLAMA__API_KEY=ollama
AIDBG_OLLAMA__MODEL=qwen2.5:14b

# which profile each agent uses (must match a profile name above, lowercased)
AIDBG_PROFILE_ORCHESTRATOR=default
AIDBG_PROFILE_ANALYST=default
AIDBG_PROFILE_CODE_RESEARCH=default
AIDBG_PROFILE_CASE_RAG=default
AIDBG_PROFILE_CASE_RECORDER=default

# UI + persistence
AIDBG_THEME=aidbg-black
AIDBG_HISTORY_PATH=.aidbg/history.jsonl
AIDBG_MCP_CONFIG=mcp_servers.json
